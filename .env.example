# Environment template for PlantView
# Copy to `backend/.env` and fill in sensitive values. Do NOT commit `.env`.

# Flask / JWT
SECRET_KEY=change-me-to-a-secure-value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168

# Database (Supabase Postgres URL)
# Local Development (PostgreSQL via Docker):
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/plantview_db
# Production (Supabase PostgreSQL):
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://<db_user>:<password>@<host>:5432/<db_name>
TEST_DATABASE_URL=sqlite:///:memory:

# Enable SQL query logging in development
DB_ECHO=false

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=plant-images

# App settings
ENV=development
TESTING=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Upload Configuration
UPLOAD_FOLDER=uploads

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Rate Limiting
LIMITER_STORAGE_URI=redis://localhost:6379/1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis
